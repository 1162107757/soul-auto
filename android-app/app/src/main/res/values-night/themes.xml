<resources>
    <style name="Theme.SoulBot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#C4B5FD</item>
        <item name="colorOnPrimary">#2E1065</item>
        <item name="colorPrimaryContainer">#4C1D95</item>
        <item name="colorOnPrimaryContainer">#EDE9FE</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="TextAppearance.SoulBot.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SoulBot.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.SoulBot.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
