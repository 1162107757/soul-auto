<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/view_toolbar" />
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="学习状态" android:textAppearance="@style/TextAppearance.SoulBot.Section" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <TextView android:id="@+id/tvLearningStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:padding="18dp" android:text="风格学习开启 · 0 条样本\n记忆引用开启 · 0 条旧版摘要" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="?attr/colorOnPrimaryContainer" />
                </com.google.android.material.card.MaterialCardView>

                <TextView android:id="@+id/tvStyleProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:text="风格档案会从人工样本中自动更新。" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="回复反馈" android:textAppearance="@style/TextAppearance.SoulBot.Section" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="先选回复场景，再标记“像我”或“不像我”。差评可以补充原因，也可以直接保存。" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="回复场景（单选）" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurface" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupFeedbackScene" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="8dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chipSceneChat" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="聊天回复" app:chipMinHeight="48dp" app:ensureMinTouchTargetSize="true" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSceneSoulMatch" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="灵魂匹配" app:chipMinHeight="48dp" app:ensureMinTouchTargetSize="true" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSceneQiyu" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="奇遇铃" app:chipMinHeight="48dp" app:ensureMinTouchTargetSize="true" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipSceneSquare" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="广场私聊" app:chipMinHeight="48dp" app:ensureMinTouchTargetSize="true" />
                </com.google.android.material.chip.ChipGroup>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="联系人（可填）">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFeedbackContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutFeedbackIncoming" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="对方消息或开场依据（必填）" app:helperText="开场可填对方资料或匹配提示，不必虚构来信。">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFeedbackIncoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:maxLength="1000" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutFeedbackReply" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="当前回复（必填）">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etFeedbackReply" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:maxLength="1000" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackLike" style="@style/Widget.SoulBot.PrimaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:text="像我，加入样本" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFeedbackDislike" style="@style/Widget.SoulBot.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="不像我，选原因" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="回复策略" android:textAppearance="@style/TextAppearance.SoulBot.Section" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchStyleLearning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="64dp" android:text="学习我的人工回复风格" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="机器人发出的内容不会作为人工风格重复学习。" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchContactMemory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="64dp" android:text="回复时使用联系人聊天记忆" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关闭后仍会在本机保存聊天记录，但生成回复时不会引用。" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="样本" android:textAppearance="@style/TextAppearance.SoulBot.Section" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="?attr/colorSurfaceVariant" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <LinearLayout android:id="@+id/rowChatSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="76dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="聊天样本管理" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="导入样本或清理旧学习数据" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                        <ImageView android:layout_width="24dp" android:layout_height="48dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
